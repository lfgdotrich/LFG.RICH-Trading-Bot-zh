chain:
  name: bsc                         # 便于阅读的链名称。BNB Smart Chain 请保持为 bsc。
  chain_id: 56                      # BNB Smart Chain 主网 chain ID。

rpc:
  request_timeout_sec: 20           # 单个 RPC 请求的超时时间，单位秒。
  max_retries: 3                    # RPC 调用失败时的重试次数。
  backoff_sec: 0.5                  # 初始重试延迟，单位秒。重试会使用递增退避。

# BSC 上默认的 LFG.RICH 协议回退值。代币合约会优先在链上解析。
lfg:
  factory: "0x429a7ef0129649a97bb3f1e961dd56d9bd4ac01f"       # 默认 Factory 回退值。优先使用代币的 FACTORY()。
  hook: "0xc18e6e1926113cdcf53f3ec1a89d3eb84cc6a888"          # 默认 Hook 回退值。优先使用代币的 hook()。
  swap_router: "0x4018abd5d24ee48c642e7e518A8Aef03B59EC150"   # 当前 LFG.RICH V5 Swap Router。用于买入/卖出执行。
  pool_manager: "0x28e2Ea090877bF75740558f6BFB36A5ffeE9e9dF"  # 协议使用的 Uniswap V4 PoolManager。

bot:
  polling_interval_sec: 120         # 每次机器人循环之间的秒数。
  trade_cooldown_sec: 300           # 交易后再次交易同一代币前等待的秒数。
  min_hold_minutes: 45              # 普通卖出逻辑可以卖出买入 lot 之前的最短持有分钟数。

  profit_gate_enabled: true         # 如果为 true，普通卖出需要达到 min_profit_pct，除非触发止损。
  min_profit_pct: 8.0               # profit gate 启用时普通卖出所需的最低利润百分比。
  max_loss_pct: 10.0                # 止损百分比。例如：10 表示 lot 达到 -10% 或更差时卖出。
  max_hold_minutes: 0               # 可选强制退出计时器，单位分钟。0 表示禁用强制退出。

  slippage_bps: 1200                # 滑点容忍度，单位基点。1200 = 12%。必须覆盖 LFG 代币费用和波动。
  gas_limit: 650000                 # LFG 买入/卖出交易使用的 gas limit。
  min_bnb_for_gas: 0.005            # 保留用于 gas 的 BNB。机器人不会花掉低于该余额的部分。
  min_trade_bnb: 0.005              # 买入/卖出操作的最低 BNB 金额。
  max_trade_bnb: 0.7                # 单笔买入/卖出操作的最高 BNB 金额。

  blocks_per_candle: 20             # 每根内部价格 K 线包含的 BSC 区块数。

  confirmations: 5                  # 在处理事件前等待的区块数，确保事件足够安全/最终。
  log_chunk_blocks: 2000            # eth_getLogs 分块大小。如果公共/免费 RPC 限速或失败，请降低。
  warmup_lookback_blocks: 20000     # 首次运行时扫描的区块数，用于为较旧代币生成历史 K 线。
  max_history_candles: 500          # 每个代币在内存/缓存中保留的最大 K 线数量。

  fast_down_enabled: true           # 启用快速下跌卖出保护。
  fast_down_candles: 5              # 用于快速下跌检测的最近真实成交量 K 线数量。
  fast_down_min_drop_pct: 0.25      # 标记快速下跌所需的最低百分比跌幅。
  fast_down_min_steps: 3            # 标记快速下跌所需的最少红/下跌 K 线步数。

  warmup_approve: true              # 如果为 true，启动时检查/授权 LFG SwapRouter 的代币 allowance。
  approve_wait_sec: 45              # 继续卖出执行前等待授权交易确认的秒数。
  dry_run: false                    # 如果为 true，只记录计划交易，不发送交易。

  test_mode: false                  # 如果为 true，强制使用 test_action，不使用策略信号。
  test_action: "SELL"               # BUY 或 SELL。仅在 test_mode 为 true 时使用。
  test_amount_bnb: 0.005            # test_mode 操作的交易大小。
  test_once: true                   # 如果为 true，执行一次测试操作后退出。

  trend_confirm_candles: 3          # 用于确认趋势方向的 K 线数量。
  ema_deadband_pct: 0.06            # EMA 死区百分比。帮助避免 EMA 很接近时的噪声翻转。
  dump_lookback: 2                  # 用于检测快速砸盘的 K 线数量。
  dump_drop_pct: 0.50               # dump_lookback K 线内标记砸盘的百分比跌幅。
  pump_lookback: 2                  # 用于检测快速拉盘的 K 线数量。
  pump_rise_pct: 0.50               # pump_lookback K 线内标记拉盘的百分比涨幅。
  bleed_lookback: 5                 # 用于检测慢跌/下跌趋势的 K 线数量。
  bleed_drop_pct: 0.50              # bleed_lookback K 线内参与慢跌检测的百分比跌幅。
  bleed_rise_pct: 0.50              # 用于区分恢复和慢跌的百分比涨幅阈值。
  bleed_min_steps: 5                # 慢跌检测所需的最少下跌步数。

watchlist:
  tokens:
    - symbol: "LFGBULL"             # 代币符号/ticker
      address: "0x29Ede1E1254419Fe5a3c803fC2b015042075A49A"  # LFG.RICH 代币合约地址。
      max_alloc_bnb: 0.05           # 该代币允许的最大总 BNB 分配。
      add_step_bnb: 0.005           # 策略决定买入/加仓时要增加的 BNB 数量。
      timeframe_sec: 120            # 预期策略时间周期，单位秒。保留用于兼容策略设置/日志。
      ema_fast: 3                   # 策略使用的快速 EMA 周期。
      ema_slow: 9                   # 策略使用的慢速 EMA 周期。
      rsi_period: 7                 # 策略使用的 RSI 周期。
      dust_size: 0.0001             # 低于该数量的代币会在本地 lot 记账中视为 dust/已关闭。
      dex: "lfg"                    # 交易场所。LFG.RICH 代币请保持为 lfg。
      # pool_id: "0x..."             # 可选覆盖。通常会从 token.poolId()/Factory/Hook 在链上解析。
